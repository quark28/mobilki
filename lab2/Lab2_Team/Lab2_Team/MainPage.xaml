<?xml version="1.0" encoding="utf-8" ?>
<!-- Главная страница — FlyoutPage (задача 2):
     Flyout — меню слева, Detail — выбранная страница справа -->
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:Lab2_Team"
            x:Class="Lab2_Team.MainPage"
            FlyoutLayoutBehavior="Split"
            IsPresented="True">

    <FlyoutPage.Flyout>
        <local:FlyOutMenuPage x:Name="flyoutPage" />
    </FlyoutPage.Flyout>

    <!-- При запуске справа открыта страница команды -->
    <FlyoutPage.Detail>
        <NavigationPage BarBackgroundColor="#1A237E"
                        BarTextColor="White">
            <x:Arguments>
                <local:TeamPage />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>
</FlyoutPage>
